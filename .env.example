# Personal Knowledge Hub example environment file
# The current MVP stores model settings through the Web UI.
# Keep this file as a safe template for future deployment configuration.

# Backend
PKH_HOST=127.0.0.1
PKH_PORT=8088
PKH_DATA_DIR=./backend/data

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8088/api

# Chat model, OpenAI-compatible
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=gpt-4.1-mini
CHAT_TIMEOUT_SECONDS=45

# Embedding model, OpenAI-compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=45

# Optional MinerU parser service
MINERU_BASE_URL=
MINERU_API_KEY=

# Optional Chroma path
CHROMA_PATH=./backend/data/chroma
CHROMA_COLLECTION=personal_knowledge_chunks
